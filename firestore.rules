rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos personales: cada persona lee y escribe solo los suyos.
    match /users/{uid}/docs/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Grupos: cualquiera que tenga el código (el link) puede verlo y anotar.
    // Nadie puede listar todos los grupos, así que sin el código no se encuentran.
    match /groups/{gid} {
      allow get: if request.auth != null;
      allow list, delete: if false;
      allow create, update: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 50;

      match /exp/{eid} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.desc is string
          && request.resource.data.desc.size() <= 80
          && request.resource.data.paidBy is string
          && request.resource.data.split is map;
      }
    }
  }
}
